@model CagriMerkeziUyg.Models.Randevu

@{
    ViewData["Title"] = "Yeni Randevu Oluştur";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bx bx-calendar-plus me-2"></i>Yeni Randevu Oluştur
                    </h5>
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i>Geri
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Olustur" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <!-- Sol Kolon -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Baslik" class="form-label"></label>
                                    <input asp-for="Baslik" class="form-control" placeholder="Randevu başlığı" />
                                    <span asp-validation-for="Baslik" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Tip" class="form-label"></label>
                                    <select asp-for="Tip" class="form-select" asp-items="ViewBag.RandevuTipleri">
                                        <option value="">Seçiniz...</option>
                                    </select>
                                    <span asp-validation-for="Tip" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="MusteriId" class="form-label">
                                        <i class="bx bx-search me-1"></i>Müşteri Ara ve Seç
                                    </label>
                                    <select asp-for="MusteriId" id="musteriSelect" class="form-select" style="width: 100%">
                                        <option value="">Müşteri aramak için yazmaya başlayın...</option>
                                        @if (Model.MusteriId.HasValue && ViewBag.MusteriAdi != null)
                                        {
                                            <option value="@Model.MusteriId" selected>@ViewBag.MusteriAdi</option>
                                        }
                                    </select>
                                    <small class="text-muted">
                                        <i class="bx bx-info-circle"></i>
                                        Ad, soyad, telefon veya e-posta ile arayabilirsiniz
                                    </small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="OperatorId" class="form-label"></label>
                                    <select asp-for="OperatorId" class="form-select" asp-items="ViewBag.Operatorler">
                                        <option value="">Operatör Seçiniz...</option>
                                    </select>
                                    <span asp-validation-for="OperatorId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Aciklama" class="form-label"></label>
                                    <textarea asp-for="Aciklama" class="form-control" rows="4" placeholder="Randevu hakkında detaylı açıklama..."></textarea>
                                    <span asp-validation-for="Aciklama" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Sağ Kolon -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="RandevuZamani" class="form-label">
                                        <i class="bx bx-calendar-event me-1"></i>Randevu Tarihi ve Saati
                                    </label>
                                    <input asp-for="RandevuZamani" type="text" class="form-control" placeholder="Tarih ve saat seçiniz" />
                                    <span asp-validation-for="RandevuZamani" class="text-danger"></span>
                                    <small class="text-muted">
                                        <i class="bx bx-info-circle"></i>
                                        Sadece saat ve dakika - Format: GG.AA.YYYY SS:DD
                                    </small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="BitisZamani" class="form-label">
                                        <i class="bx bx-calendar-check me-1"></i>Bitiş Tarihi ve Saati
                                    </label>
                                    <input asp-for="BitisZamani" type="text" class="form-control" placeholder="Bitiş zamanı (opsiyonel)" />
                                    <small class="text-muted">Opsiyonel - Belirtilmezse 30 dakika süre varsayılır</small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Oncelik" class="form-label"></label>
                                    <select asp-for="Oncelik" class="form-select" asp-items="ViewBag.RandevuOncelikleri">
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Durum" class="form-label"></label>
                                    <select asp-for="Durum" class="form-select" asp-items="ViewBag.RandevuDurumlari">
                                    </select>
                                </div>

                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">
                                            <i class="bx bx-bell me-2"></i>Hatırlatma Ayarları
                                        </h6>
                                        
                                        <div class="form-check form-switch mb-3">
                                            <input asp-for="HatirlatmaAktif" class="form-check-input" type="checkbox" />
                                            <label asp-for="HatirlatmaAktif" class="form-check-label"></label>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="HatirlatmaSuresi" class="form-label"></label>
                                            <select asp-for="HatirlatmaSuresi" class="form-select">
                                                <option value="5">5 dakika önce</option>
                                                <option value="15" selected>15 dakika önce</option>
                                                <option value="30">30 dakika önce</option>
                                                <option value="60">1 saat önce</option>
                                                <option value="120">2 saat önce</option>
                                                <option value="1440">1 gün önce</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="bx bx-save me-1"></i>Randevu Oluştur
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="bx bx-x me-1"></i>İptal
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <!-- Select2 CSS & JS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <!-- Flatpickr CSS & JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/confirmDate/confirmDate.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>
    
    <script>
        $(document).ready(function() {
            // Select2 ile müşteri arama
            $('#musteriSelect').select2({
                theme: 'bootstrap-5',
                placeholder: 'Müşteri aramak için yazmaya başlayın...',
                allowClear: true,
                minimumInputLength: 2,
                language: {
                    inputTooShort: function() {
                        return 'En az 2 karakter giriniz';
                    },
                    searching: function() {
                        return 'Aranıyor...';
                    },
                    noResults: function() {
                        return 'Sonuç bulunamadı';
                    }
                },
                ajax: {
                    url: '@Url.Action("MusteriAra", "Randevu")',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return {
                            term: params.term
                        };
                    },
                    processResults: function(data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                }
            });

            // Flatpickr ile tarih seçici 
            var randevuPicker = flatpickr("#RandevuZamani", {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                time_24hr: true,
                locale: "tr",
                defaultDate: new Date(Date.now() + 3600000), // 1 saat sonrası
                minuteIncrement: 1,
                onChange: function(selectedDates, dateStr, instance) {
                    var selectedDate = selectedDates[0];
                    var now = new Date();
                    
                    if (selectedDate <= now) {
                        alert('⚠️ Randevu tarihi geçmiş bir tarih olamaz! Lütfen gelecek bir tarih seçiniz.');
                        instance.clear();
                    }
                }
            });

            var bitisPicker = flatpickr("#BitisZamani", {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                time_24hr: true,
                locale: "tr",
                defaultDate: new Date(Date.now() + 7200000), // 2 saat sonrası
                minuteIncrement: 1,
                onChange: function(selectedDates, dateStr, instance) {
                    var randevuVal = $('#RandevuZamani').val();
                    if (randevuVal) {
                        var baslangic = new Date(randevuVal);
                        var bitis = selectedDates[0];
                        
                        if (bitis <= baslangic) {
                            alert('⚠️ Bitiş zamanı, başlangıç zamanından sonra olmalıdır!');
                            instance.clear();
                        }
                    }
                }
            });
        });
    </script>
}


