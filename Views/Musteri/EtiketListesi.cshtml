@model IEnumerable<CagriMerkeziUyg.Models.MusteriEtiketi>
@{
    ViewData["Title"] = "Etiket Listesi";
}

<!-- Header -->
<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bx bx-tag me-1"></i>Etiket Listesi
                </h5>
                <a href="@Url.Action("EtiketOlustur")" class="btn btn-primary">
                    <i class="bx bx-plus me-1"></i>Yeni Etiket Oluştur
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Etiket</th>
                                    <th>Açıklama</th>
                                    <th>Renk</th>
                                    <th>Durum</th>
                                    <th>Oluşturulma Tarihi</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var etiket in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge" style="background-color: @etiket.RenkKodu; color: white;">
                                                @etiket.Ad
                                            </span>
                                        </td>
                                        <td>@etiket.Aciklama</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="color-preview me-2" style="width: 20px; height: 20px; background-color: @etiket.RenkKodu; border-radius: 3px;"></div>
                                                <small class="text-muted">@etiket.RenkKodu</small>
                                            </div>
                                        </td>
                                        <td>
                                            @if (etiket.Aktif)
                                            {
                                                <span class="badge bg-success">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Pasif</span>
                                            }
                                        </td>
                                        <td>@etiket.OlusturulmaTarihi.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("EtiketDuzenle", new { id = etiket.Id })" class="btn btn-sm btn-outline-primary">
                                                    <i class="bx bx-edit"></i>
                                                </a>
                                                <form asp-action="EtiketSil" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@etiket.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                            onclick="return confirm('Bu etiketi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.')">
                                                        <i class="bx bx-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bx bx-tag display-1 text-muted"></i>
                        <h5 class="mt-3 text-muted">Henüz etiket oluşturulmamış</h5>
                        <p class="text-muted">İlk etiketinizi oluşturmak için yukarıdaki butonu kullanın.</p>
                        <a href="@Url.Action("EtiketOlustur")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i>İlk Etiketi Oluştur
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Toast Messages -->
@if (TempData["Success"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
        <div class="toast show" role="alert">
            <div class="toast-header text-success">
                <i class="bx bx-check-circle me-2"></i>
                <strong class="me-auto">Başarılı</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                @TempData["Success"]
            </div>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
        <div class="toast show" role="alert">
            <div class="toast-header text-danger">
                <i class="bx bx-x-circle me-2"></i>
                <strong class="me-auto">Hata</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                @TempData["Error"]
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        setTimeout(function() {
            $('.toast').fadeOut();
        }, 5000);
    </script>
}

















