@model CagriMerkeziUyg.Models.Musteri
@{
    ViewData["Title"] = "Müşteri Detayları";
}

<!-- Header -->
<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bx bx-user me-1"></i>Müşteri Detayları - @Model.TamAd
                </h5>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-style1 mb-0">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Ara")">Müşteri Ara</a>
                        </li>
                        <li class="breadcrumb-item active">@Model.TamAd</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Müşteri İstatistikleri -->
    <div class="col-xl-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bx bx-bar-chart-alt-2 me-1"></i>Aktivite İstatistikleri
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Özet Bilgiler -->
                    <div class="row text-center mb-4">
                        <div class="col-6">
                            <div class="border-end">
                                <h4 id="musteriToplamAktivite" class="text-primary mb-1">@Model.Aktiviteler.Count()</h4>
                                <small class="text-muted">Toplam Aktivite</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <h4 id="musteriEnCokTur" class="text-success mb-1">
                                @if (Model.Aktiviteler.Any())
                                {
                                    @Model.Aktiviteler.GroupBy(a => a.Tur).OrderByDescending(g => g.Count()).First().Key
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </h4>
                            <small class="text-muted">En Çok Kullanılan</small>
                        </div>
                    </div>

                    <!-- Mini Grafik -->
                    @if (Model.Aktiviteler.Any())
                    {
                        <div class="mb-3">
                            <canvas id="musteriAktiviteGrafik" height="200"></canvas>
                            <div id="musteriGrafikYukleniyor" class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">Yükleniyor...</span>
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-outline-primary btn-sm w-100" onclick="musteriIstatistikleriniYukle()">
                            <i class="bx bx-refresh me-1"></i>Grafikleri Yenile
                        </button>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bx bx-pie-chart-alt-2 display-4 text-muted"></i>
                            <p class="text-muted mt-2">Henüz aktivite bulunmuyor</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <!-- Müşteri Bilgileri -->
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Kişisel Bilgiler</h5>
                <div>
                    <a href="@Url.Action("Duzenle", new { id = Model.Id })" class="btn btn-primary btn-sm">
                        <i class="bx bx-edit me-1"></i>Düzenle
                    </a>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#silModal">
                <i class="bx bx-trash me-1"></i>Sil
            </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Temel Bilgiler -->
                    <div class="col-md-6">
                        <div class="info-item mb-3">
                            <label class="form-label text-muted mb-1">
                                <i class="bx bx-phone me-1"></i>Telefon Numarası
                            </label>
                            <div class="fw-medium">
                                <a href="tel:@Model.TelefonNo" class="text-decoration-none">
                                    @Model.TelefonNo
                                </a>
                            </div>
                        </div>
                        
                        <div class="info-item mb-3">
                            <label class="form-label text-muted mb-1">
                                <i class="bx bx-user me-1"></i>Ad Soyad
                            </label>
                            <div class="fw-medium">@Model.TamAd</div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <div class="info-item mb-3">
                                <label class="form-label text-muted mb-1">
                                    <i class="bx bx-envelope me-1"></i>E-posta
                                </label>
                                <div class="fw-medium">
                                    <a href="mailto:@Model.Email" class="text-decoration-none">
                                        @Model.Email
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="col-md-6">
                        @if (Model.DogumTarihi.HasValue)
                        {
                            <div class="info-item mb-3">
                                <label class="form-label text-muted mb-1">
                                    <i class="bx bx-calendar me-1"></i>Doğum Tarihi
                                </label>
                                <div class="fw-medium">
                                    @Model.DogumTarihi.Value.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                </div>
                            </div>
                        }
                        
                        @if (Model.Yas.HasValue)
                        {
                            <div class="info-item mb-3">
                                <label class="form-label text-muted mb-1">
                                    <i class="bx bx-time me-1"></i>Yaş
                                </label>
                                <div class="fw-medium">@Model.Yas yaşında</div>
                            </div>
                        }
                        
                        <div class="info-item mb-3">
                            <label class="form-label text-muted mb-1">
                                <i class="bx bx-calendar-plus me-1"></i>Kayıt Tarihi
                            </label>
                            <div class="fw-medium">
                                @Model.KayitTarihi.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("tr-TR"))
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Adres -->
                @if (!string.IsNullOrEmpty(Model.Adres))
                {
                    <hr class="my-4">
                    <div class="info-item">
                        <label class="form-label text-muted mb-2">
                            <i class="bx bx-map me-1"></i>Adres
                        </label>
                        <div class="fw-medium">@Model.Adres</div>
                    </div>
                }
                
                <!-- Müşteri Tipi -->
                @if (Model.MusteriTipi.HasValue)
                {
                    <hr class="my-4">
                    <div class="info-item">
                        <label class="form-label text-muted mb-2">
                            <i class="bx bx-category me-1"></i>Müşteri Tipi
                        </label>
                        <div class="fw-medium">
                            <span class="badge bg-primary">@Model.MusteriTipi.Value</span>
                        </div>
                    </div>
                }

                <!-- Etiketler -->
                @if (ViewBag.MevcutEtiketler != null && ((List<CagriMerkeziUyg.Models.MusteriEtiketi>)ViewBag.MevcutEtiketler).Any())
                {
                    <hr class="my-4">
                    <div class="info-item">
                        <label class="form-label text-muted mb-2">
                            <i class="bx bx-tag me-1"></i>Etiketler
                        </label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var etiket in (List<CagriMerkeziUyg.Models.MusteriEtiketi>)ViewBag.MevcutEtiketler)
                            {
                                <span class="badge" style="background-color: @etiket.RenkKodu; color: white;">
                                    @etiket.Ad
                                </span>
                            }
                        </div>
                        <div class="mt-2">
                            <a href="@Url.Action("EtiketYonetimi", new { id = Model.Id })" class="btn btn-outline-primary btn-sm">
                                <i class="bx bx-edit me-1"></i>Etiketleri Yönet
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <hr class="my-4">
                    <div class="info-item">
                        <label class="form-label text-muted mb-2">
                            <i class="bx bx-tag me-1"></i>Etiketler
                        </label>
                        <div class="text-muted mb-2">Henüz etiket atanmamış</div>
                        <a href="@Url.Action("EtiketYonetimi", new { id = Model.Id })" class="btn btn-outline-primary btn-sm">
                            <i class="bx bx-plus me-1"></i>Etiket Ekle
                        </a>
                    </div>
                }

                <!-- Notlar -->
                @if (!string.IsNullOrEmpty(Model.Notlar))
                {
                    <hr class="my-4">
                    <div class="info-item">
                        <label class="form-label text-muted mb-2">
                            <i class="bx bx-note me-1"></i>Notlar
                        </label>
                        <div class="fw-medium">@Model.Notlar</div>
                    </div>
                }

                <!-- Özel Notlar -->
                @if (!string.IsNullOrEmpty(Model.OzelNotlar))
                {
                    <hr class="my-4">
                    <div class="info-item">
                        <label class="form-label text-muted mb-2">
                            <i class="bx bx-star me-1"></i>Özel Notlar
                        </label>
                        <div class="fw-medium">@Model.OzelNotlar</div>
                    </div>
                }
            </div>
        </div>
        
        <!-- İşlem Geçmişi -->
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bx bx-history me-1"></i>İşlem Geçmişi
                </h5>
            </div>
            <div class="card-body">
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-point timeline-point-success"></div>
                        <div class="timeline-event">
                            <div class="timeline-header mb-1">
                                <h6 class="mb-0">Müşteri Kaydı Oluşturuldu</h6>
                                <small class="text-muted">@Model.KayitTarihi.ToString("dd MMM yyyy HH:mm")</small>
                            </div>
                            <p class="mb-0">Yeni müşteri kaydı sisteme eklendi.</p>
                        </div>
                    </div>
                    
                    @if (Model.SonGuncelleme != Model.KayitTarihi)
                    {
                        <div class="timeline-item">
                            <div class="timeline-point timeline-point-info"></div>
                            <div class="timeline-event">
                                <div class="timeline-header mb-1">
                                    <h6 class="mb-0">Bilgiler Güncellendi</h6>
                                    <small class="text-muted">@Model.SonGuncelleme.ToString("dd MMM yyyy HH:mm")</small>
                                </div>
                                <p class="mb-0">Müşteri bilgileri güncellendi.</p>
                            </div>
                        </div>
                    }
                    
                    <div class="timeline-item">
                        <div class="timeline-point timeline-point-primary"></div>
                        <div class="timeline-event">
                            <div class="timeline-header mb-1">
                                <h6 class="mb-0">Son Görüntüleme</h6>
                                <small class="text-muted">Şimdi</small>
                            </div>
                            <p class="mb-0">Müşteri detayları görüntülendi.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Yeni Aktivite Ekle -->
        <div class="card mt-4">
            <div class="card-header">
                <h5> Yeni Aktivite Ekle</h5>
            </div>
            <div class="card-body">
                <form asp-action="AktiviteEkle" method="post">
                    <input type="hidden" name="musteriId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label>Tür:</label>
                        
                        <select name="tur" class="form-select">
                            <option value="Sikayet">Şikayet</option>
                            <option value="Talep">Talep</option>
                            <option value="Bilgi">Bilgi</option>
                            <option value="Oneri">Öneri</option>
                            <option value="Diger">Diğer</option>
                            </select>
                    </div>
                    
                    <div class="mb-3">
                        <label>Açıklama:</label>
                        <textarea name="aciklama" class="form-control" rows="4" style=" resize:none" required 
                        placeholder="Lütfen bu alanı doldurun."></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-success">Kaydet</button>
                </form>
            </div>
        </div>

        @if (Model.Aktiviteler != null && Model.Aktiviteler.Any())
        {
            <div class="card mt-4">
                <div class="card-header">
                    <h5>Aktivite Geçmişi (@Model.Aktiviteler.Count())</h5>
                </div>

                <!-- Filtreleme Paneli -->
                <div class="card-body border-bottom">
                    <div class="row g-3">
                        <!-- Aktivite Türü -->
                        <div class="col-md-3">
                            <label class="form-label">Aktivite Türü</label>
                            <select id="aktiviteTuru" class="form-select">
                                <option value="">Tüm Aktiviteler</option>
                                <option value="Sikayet">Şikayet</option>
                                <option value="Talep">Talep</option>
                                <option value="Bilgi">Bilgi</option>
                                <option value="Oneri">Öneri</option>
                                <option value="Diger">Diğer</option>
                            </select>
                        </div>

                        <!-- Başlangıç Tarihi -->
                        <div class="col-md-3">
                            <label class="form-label">Başlangıç Tarihi</label>
                            <input type="date" id="baslangicTarihi" class="form-control">
                        </div>

                        <!-- Bitiş Tarihi -->
                        <div class="col-md-3">
                            <label class="form-label">Bitiş Tarihi</label>
                            <input type="date" id="bitisTarihi" class="form-control">
                        </div>

                        <!-- Arama -->
                        <div class="col-md-3">
                            <label class="form-label">Açıklama İçinde Ara</label>
                            <div class="input-group">
                                <input type="text" id="aramaMetni" class="form-control" placeholder="Arama...">
                                <button class="btn btn-outline-secondary" type="button" id="aramaTemizle">
                                    <i class="bx bx-x"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <button id="filtreUygula" class="btn btn-primary me-2">
                                <i class="bx bx-filter-alt me-1"></i>Filtrele
                            </button>
                            <button id="filtreTemizle" class="btn btn-outline-secondary">
                                <i class="bx bx-refresh me-1"></i>Temizle
                            </button>
                            <small class="text-muted ms-3">
                                <span id="sonucSayisi">@Model.Aktiviteler.Count()</span> sonuç gösteriliyor
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Aktivite Listesi -->
                <div class="card-body">
                    <div id="aktiviteListesi">
                        @await Html.PartialAsync("AktiviteListesi", Model.Aktiviteler.OrderByDescending(a => a.OlusturulmaTarihi))
                    </div>

                    <!-- Yükleniyor göstergesi -->
                    <div id="yukleniyorGostergesi" class="text-center py-4" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                        <p class="mt-2 text-muted">Aktiviteler yükleniyor...</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mt-4">
                <div class="card-header">
                    <h5>Aktivite Geçmişi</h5>
                </div>
                <div class="card-body text-center py-5">
                    <i class="bx bx-history display-3 text-muted"></i>
                    <h6 class="mt-3 text-muted">Henüz aktivite bulunmuyor</h6>
                    <p class="text-muted">Bu müşteri için henüz herhangi bir aktivite kaydedilmemiş.</p>
                </div>
            </div>
        }
    </div>

<!-- Silme Modal -->
<div class="modal fade" id="silModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bx bx-trash me-1"></i>Müşteriyi Sil
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger">
                    <h6 class="alert-heading">Dikkat!</h6>
                    <p class="mb-0">
                        <strong>@Model.TamAd</strong> adlı müşteriyi silmek istediğinizden emin misiniz?
                        Bu işlem geri alınamaz.
                    </p>
                </div>
                
                <div class="row">
                    <div class="col-6">
                        <strong>Telefon:</strong><br>
                        @Model.TelefonNo
                    </div>
                    <div class="col-6">
                        <strong>Kayıt Tarihi:</strong><br>
                        @Model.KayitTarihi.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bx bx-x me-1"></i>İptal
                </button>
                <form asp-action="Sil" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bx bx-trash me-1"></i>Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Toast Messages -->
@if (TempData["Success"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
        <div class="toast show" role="alert">
            <div class="toast-header text-success">
                <i class="bx bx-check-circle me-2"></i>
                <strong class="me-auto">Başarılı</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                @TempData["Success"]
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        setTimeout(function() {
            $('.toast').fadeOut();
        }, 5000);

        // Aktivite filtreleme
        $(document).ready(function() {
            var musteriId = parseInt('@Model.Id');

            // Filtre uygula butonu
            $('#filtreUygula').click(function() {
                aktiviteFiltrelemeUygula();
            });

            // Enter tuşu ile arama
            $('#aramaMetni').keypress(function(e) {
                if (e.which == 13) {
                    aktiviteFiltrelemeUygula();
                }
            });

            // Müşteri istatistiklerini yükle
            var aktiviteVarMi = '@(Model.Aktiviteler != null && Model.Aktiviteler.Any())' === 'True';
            if (aktiviteVarMi) {
                
                if (typeof Chart === 'undefined') {
                    var script = document.createElement('script');
                    script.src = 'https://cdn.jsdelivr.net/npm/chart.js';
                    script.onload = function() {
                        musteriIstatistikleriniYukle();
                    };
                    document.head.appendChild(script);
                } else {
                    musteriIstatistikleriniYukle();
                }
            }

            // Müşteri istatistikleri fonksiyonu
            function musteriIstatistikleriniYukle() {
                var musteriId = parseInt('@Model.Id');

                // AJAX ile müşteri istatistiklerini çekme
                $.ajax({
                    url: '@Url.Action("MusteriAktiviteIstatistikleri", "Musteri")',
                    type: 'GET',
                    data: { musteriId: musteriId },
                    success: function(data) {
                        $('#musteriGrafikYukleniyor').hide();
                        musteriAktiviteGrafiginiOlustur(data.aktiviteTurleri);
                    },
                    error: function() {
                        $('#musteriGrafikYukleniyor').html('<p class="text-danger small">Grafik yüklenemedi</p>');
                    }
                });
            }

            // Müşteri aktivite grafiği (mini pasta grafiği)
            function musteriAktiviteGrafiginiOlustur(data) {
                const ctx = document.getElementById('musteriAktiviteGrafik');
                if (!ctx) return;

                const renkler = ['#dc3545', '#ffc107', '#17a2b8', '#28a745', '#6c757d'];

                // Eğer önceki grafik varsa temizle
                if (window.musteriChart) {
                    window.musteriChart.destroy();
                }

                window.musteriChart = new Chart(ctx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: data.map(item => item.tur),
                        datasets: [{
                            data: data.map(item => item.sayi),
                            backgroundColor: renkler.slice(0, data.length),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    font: {
                                        size: 10
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Filtreleri temizle
            $('#filtreTemizle').click(function() {
                $('#aktiviteTuru').val('');
                $('#baslangicTarihi').val('');
                $('#bitisTarihi').val('');
                $('#aramaMetni').val('');
                aktiviteFiltrelemeUygula();
            });

            // Arama temizle butonu
            $('#aramaTemizle').click(function() {
                $('#aramaMetni').val('');
                aktiviteFiltrelemeUygula();
            });

            // Filtreleme fonksiyonu
            function aktiviteFiltrelemeUygula() {
                const tur = $('#aktiviteTuru').val();
                const baslangicTarihi = $('#baslangicTarihi').val();
                const bitisTarihi = $('#bitisTarihi').val();
                const aramaMetni = $('#aramaMetni').val();

                // Yükleniyor göstergesi
                $('#yukleniyorGostergesi').show();
                $('#aktiviteListesi').hide();

                // AJAX çağrısı
                $.ajax({
                    url: '@Url.Action("AktiviteFiltreleme")',
                    type: 'GET',
                    data: {
                        musteriId: musteriId,
                        tur: tur,
                        baslangicTarihi: baslangicTarihi,
                        bitisTarihi: bitisTarihi,
                        aramaMetni: aramaMetni
                    },
                    success: function(data) {
                        $('#aktiviteListesi').html(data);

                        // Sonuç sayısını güncelle
                        const sonucSayisi = $(data).find('.border-start').length;
                        $('#sonucSayisi').text(sonucSayisi);

                        // Yükleniyor gizle, sonuçları göster
                        $('#yukleniyorGostergesi').hide();
                        $('#aktiviteListesi').show();
                    },
                    error: function() {
                        $('#yukleniyorGostergesi').hide();
                        $('#aktiviteListesi').show();

                        // Hata mesajı göster
                        alert('Aktiviteler yüklenirken bir hata oluştu.');
                    }
                });
            }
        });
    </script>
}