@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="container-fluid">
    <div class="row justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="col-md-6 text-center">
            <div class="card border-danger">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="fas fa-ban fa-5x text-danger"></i>
                    </div>
                    <h1 class="card-title text-danger mb-3">Erişim Engellendi</h1>
                    <p class="card-text lead mb-4">
                        Bu sayfaya erişim yetkiniz bulunmamaktadır.
                    </p>
                    <p class="text-muted mb-4">
                        Eğer bu sayfaya erişmeniz gerektiğini düşünüyorsanız, lütfen sistem yöneticiniz ile iletişime geçin.
                    </p>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Geri Dön
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>Ana Sayfa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





















